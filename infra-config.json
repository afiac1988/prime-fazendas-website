{
  "system": {
    "name": "Prime Fazendas Autonomous System",
    "version": "1.0.0",
    "mode": "autonomous",
    "status": "active"
  },
  "github": {
    "repo": "afiac1988/prime-fazendas-website",
    "owner": "afiac1988",
    "branch": "main",
    "auth_method": "cli",
    "auto_push": true
  },
  "vercel": {
    "auto_deploy": true,
    "build_time_estimate_seconds": 60,
    "site_url": "https://primefazendas.com/",
    "check_live_after_deploy": true
  },
  "content": {
    "auto_seo": true,
    "auto_validate": true,
    "staging_folder": "data/content-staging",
    "supported_formats": ["html", "json", "md"],
    "max_content_size_mb": 50
  },
  "watcher": {
    "enabled": true,
    "check_interval_seconds": 45,
    "flag_file": "_PUBLISH.flag",
    "monitor_paths": [
      "*.html",
      "*.json",
      "*.md",
      "data/",
      "assets/",
      "en/",
      "pt/"
    ],
    "ignore_paths": [
      ".git/",
      "node_modules/",
      "infra/.env",
      "VERSOES/",
      "AUTONOMO/"
    ]
  },
  "backup": {
    "enabled": true,
    "before_publish": true,
    "location": "VERSOES/",
    "retention_days": 30
  },
  "logging": {
    "watcher_log": "VERSOES/AUTONOMO_WATCH_LOG.md",
    "changelog": "VERSOES/changelog.md",
    "console_output": true,
    "detailed_logging": true
  },
  "security": {
    "token_location": "infra/.env",
    "token_never_exposed": true,
    "only_system_can_publish": true,
    "changelog_automatic": true,
    "logging_complete": true,
    "public_gate": "gate + noindex",
    "gate_review_at_launch": "required"
  },
  "verification": {
    "check_live_after_deploy": true,
    "browser": "Chrome",
    "test_clickable_elements": true,
    "test_images_load": true,
    "test_response_time": true,
    "timeout_seconds": 30
  },
  "notifications": {
    "on_publish": true,
    "on_error": true,
    "notification_type": "console"
  }
}
